# Application
NODE_ENV=development
APP_NAME=clinic-ai-copilot

# Frontend (Vite dev server)
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:3001

# Backend API (Express)
API_PORT=3001

# Single role for the simplified app
APP_ROLE=doctor

# PostgreSQL (introduced in a later stage)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinic_ai_copilot
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://clinic_app:change_me@localhost:5432/clinic_ai_copilot

# MongoDB (introduced in a later stage)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=clinic_ai_copilot
MONGO_URL=mongodb://localhost:27017/clinic_ai_copilot

# AI provider (introduced in a later stage)
AI_PROVIDER=openai
AI_API_KEY=replace_with_local_secret

# Security
JWT_SECRET=replace_with_local_secret
