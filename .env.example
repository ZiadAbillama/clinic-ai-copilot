# Application
NODE_ENV=development
APP_NAME=clinic-ai-copilot

# Frontend (Vite dev server)
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:3001

# Backend API (Express)
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Single role for the simplified app
APP_ROLE=doctor
DEMO_DOCTOR_ID=demo-doctor
DEMO_DOCTOR_EMAIL=doctor@clinikit.local
DEMO_DOCTOR_NAME=Demo Doctor
DEMO_DOCTOR_PASSWORD=replace_with_demo_password

# MongoDB Atlas
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/clinic_ai_copilot

# Local AI provider
OLLAMA_URL=http://localhost:11434
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=45000

# Security
JWT_SECRET=replace_with_local_secret
