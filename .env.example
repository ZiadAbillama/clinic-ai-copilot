# Application
NODE_ENV=development
APP_NAME=clinic-ai-copilot

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# API Gateway
API_GATEWAY_PORT=3001

# Services
PATIENT_SERVICE_PORT=3101
APPOINTMENT_SERVICE_PORT=3102
NOTES_SERVICE_PORT=3103
AI_SERVICE_PORT=3104

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinic_ai_copilot
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://clinic_app:change_me@localhost:5432/clinic_ai_copilot

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=clinic_ai_copilot
MONGO_URL=mongodb://localhost:27017/clinic_ai_copilot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Vector database
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_COLLECTION=medical_notes

# AI provider
AI_PROVIDER=openai
AI_API_KEY=replace_with_local_secret

# Security
JWT_SECRET=replace_with_local_secret
