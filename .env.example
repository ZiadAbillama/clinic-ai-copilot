# Application
NODE_ENV=development
APP_NAME=clinic-ai-copilot

# Frontend (Vite dev server)
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:3001

# Backend API (Express)
API_PORT=3001

# Single role for the simplified app
APP_ROLE=doctor
DEMO_DOCTOR_ID=demo-doctor

# MongoDB Atlas
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/clinic_ai_copilot

# Local AI provider (introduced in a later stage)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Security (introduced in a later stage)
JWT_SECRET=replace_with_local_secret
